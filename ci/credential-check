#!/bin/sh
# Run the agent credential check from an exact authority commit (Decision 0101).
#
# Usage: ci/credential-check <authority-commit> --repository <owner/name> [options]
#
# Retrieve this wrapper from protected main with `git show <commit>:ci/credential-check`
# and run it with that same commit. The checker that judges the token and the
# declaration it judges against both come from that commit, never from the editable
# checkout the agent works in: a candidate cannot authorize its own first provider
# write (Codex on #364; owner decision 2026-10-05). The checkout is read only for how
# it pushes (--worktree).
set -eu

# A fixed trusted executable search path, as the preparation wrapper uses, before
# anything from the checkout is touched.
PATH=/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin
export PATH

git_executable="$(command -v git || true)"
python_executable="$(command -v python3 || command -v python || true)"
mktemp_executable="$(command -v mktemp || true)"
tar_executable="$(command -v tar || true)"
if [ -z "$git_executable" ] || [ -z "$python_executable" ] \
  || [ -z "$mktemp_executable" ] || [ -z "$tar_executable" ]; then
  echo "ERROR: trusted credential-check executables are unavailable" >&2
  exit 2
fi

authority="${1:-}"
if [ "$#" -gt 0 ]; then
  shift
fi
if [ "${#authority}" -ne 40 ]; then
  echo "ERROR: the authority must be an exact 40-character commit SHA" >&2
  exit 2
fi
case "$authority" in
  *[!0-9a-f]*)
    echo "ERROR: the authority must be an exact 40-character commit SHA" >&2
    exit 2
    ;;
esac

worktree="$(pwd -P)"
tree="$("$mktemp_executable" -d "${TMPDIR:-/tmp}/gnostoa-credential-check.XXXXXX")"
archive="$tree.tar"
trap 'rm -rf -- "$tree"; rm -f -- "$archive"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

# Extract the authority with caller Git routing and global configuration scrubbed, and
# check the extraction's own success rather than a pipeline's.
if ! (
  unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY
  unset GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_INDEX_FILE GIT_CEILING_DIRECTORIES
  unset GIT_DISCOVERY_ACROSS_FILESYSTEM GIT_CONFIG GIT_CONFIG_PARAMETERS
  unset GIT_EXTERNAL_DIFF GIT_TEMPLATE_DIR GIT_REPLACE_REF_BASE
  export GIT_CONFIG_COUNT=0
  export GIT_CONFIG_GLOBAL=/dev/null
  export GIT_CONFIG_SYSTEM=/dev/null
  export GIT_CONFIG_NOSYSTEM=1
  export GIT_ATTR_NOSYSTEM=1
  export GIT_NO_REPLACE_OBJECTS=1
  "$git_executable" -c core.hooksPath=/dev/null \
    archive --format=tar --output="$archive" "${authority}^{commit}"
) 2>/dev/null || ! "$tar_executable" -x -f "$archive" -C "$tree"; then
  echo "ERROR: the authority commit could not be extracted" >&2
  exit 2
fi

# The authority's checker, under isolated Python, judging by the authority's
# declaration, appended last so no caller argument can point it elsewhere.
status=0
(
  cd "$tree"
  KNOWLEDGE_KIT_ROOT="$tree" "$python_executable" -I -c '
import sys

sys.path.insert(0, sys.argv[1])
from tools.credential_check import main

raise SystemExit(main(sys.argv[2:]))
' "$tree" --worktree "$worktree" "$@" --policy policy/agent-credentials.yaml
) || status=$?
exit "$status"
