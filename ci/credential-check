#!/bin/sh
# Run the agent credential check from an exact authority commit (Decision 0101).
#
# Usage: ci/credential-check <authority-commit> --repository <owner/name> [options]
#
# Retrieve this wrapper from protected main with `git show <commit>:ci/credential-check`
# and run it with that same commit. The checker that judges the token and the
# declaration it judges against both come from that commit, never from the editable
# checkout the agent works in: a candidate cannot authorize its own first provider
# write (Codex on #364; owner decision 2026-10-05). The checkout is read only for how
# it pushes (--worktree).
set -eu

# A fixed trusted executable search path, as the preparation wrapper uses, before
# anything from the checkout is touched.
PATH=/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin
export PATH

# `command -v` names a shell function or alias rather than a path, and a name runs
# it, so only an absolute path is run; and only one no one but root or the caller can
# replace: the file it really is, its directory and the directory it was found in, as
# `knowledge_common.trusted_executable` requires (CodeAnt on #364).
ls_executable="$(command -v ls || true)"
readlink_executable="$(command -v readlink || true)"
id_executable="$(command -v id || true)"
caller=""
case "${id_executable}" in
  /*) caller="$("${id_executable}" -u)" ;;
esac
owned() {
  case "${ls_executable}" in
    /*) ;;
    *) return 1 ;;
  esac
  listing="$("${ls_executable}" -ldn -- "$1" 2>/dev/null)" || return 1
  # The mode, the link count and the numeric owner.
  set -- ${listing}
  [ "$#" -ge 3 ] || return 1
  case "$1" in
    ?????w* | ????????w*) return 1 ;;
  esac
  [ "$3" = 0 ] || [ "$3" = "${caller}" ]
}
trusted() {
  found="$(command -v "$1" || true)"
  case "${found}:${readlink_executable}" in
    /*:/*) ;;
    *) return 1 ;;
  esac
  real="$("${readlink_executable}" -f -- "${found}" 2>/dev/null)" || return 1
  owned "${real}" && owned "${real%/*}" && owned "${found%/*}" || return 1
  printf '%s\n' "${found}"
}
unresolved=""
for name in ls readlink id; do
  trusted "${name}" >/dev/null || unresolved="${unresolved} ${name}"
done
git_executable="$(trusted git)" || unresolved="${unresolved} git"
python_executable="$(trusted python3 || trusted python)" \
  || unresolved="${unresolved} python3"
mktemp_executable="$(trusted mktemp)" || unresolved="${unresolved} mktemp"
mkdir_executable="$(trusted mkdir)" || unresolved="${unresolved} mkdir"
tar_executable="$(trusted tar)" || unresolved="${unresolved} tar"
env_executable="$(trusted env)" || unresolved="${unresolved} env"
rm_executable="$(trusted rm)" || unresolved="${unresolved} rm"
if [ -n "${unresolved}" ]; then
  echo "ERROR: trusted credential-check executables are unavailable" \
    "(not a trusted executable path:${unresolved})" >&2
  exit 2
fi

authority="${1:-}"
if [ "$#" -gt 0 ]; then
  shift
fi
if [ "${#authority}" -ne 40 ]; then
  echo "ERROR: the authority must be an exact 40-character commit SHA" >&2
  exit 2
fi
case "$authority" in
  *[!0-9a-f]*)
    echo "ERROR: the authority must be an exact 40-character commit SHA" >&2
    exit 2
    ;;
esac

worktree="$(pwd -P)"
work="$("${mktemp_executable}" -d "${TMPDIR:-/tmp}/gnostoa-credential-check.XXXXXX")"
tree="${work}/tree"
archive="${work}/authority.tar"
trap '"${rm_executable}" -rf -- "${work}"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

# Extract the authority reading none of the checkout's configuration or attributes,
# whose filter drivers `git archive` would run: disposable metadata from an empty
# template, bound to the checkout's object store, as the helper's fetch and preparation
# bind theirs. tar runs with an empty environment, so `TAR_OPTIONS` cannot add an option
# (Codex on #364). The extraction's own success is checked, not a pipeline's.
if ! (
  unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY
  unset GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_INDEX_FILE GIT_CEILING_DIRECTORIES
  unset GIT_DISCOVERY_ACROSS_FILESYSTEM GIT_CONFIG GIT_CONFIG_PARAMETERS
  unset GIT_EXTERNAL_DIFF GIT_TEMPLATE_DIR GIT_REPLACE_REF_BASE
  export GIT_CONFIG_COUNT=0
  export GIT_CONFIG_GLOBAL=/dev/null
  export GIT_CONFIG_SYSTEM=/dev/null
  export GIT_CONFIG_NOSYSTEM=1
  export GIT_ATTR_NOSYSTEM=1
  export GIT_NO_REPLACE_OBJECTS=1
  common="$("${git_executable}" rev-parse --path-format=absolute --git-common-dir)" \
    || exit 1
  "${mkdir_executable}" "${work}/template" "${tree}" || exit 1
  "${git_executable}" init --quiet --bare --template="${work}/template" "${work}/git" \
    || exit 1
  printf '%s\n' "${common}/objects" > "${work}/git/objects/info/alternates" || exit 1
  GIT_DIR="${work}/git"
  GIT_OBJECT_DIRECTORY="${common}/objects"
  export GIT_DIR GIT_OBJECT_DIRECTORY
  "${git_executable}" -c core.hooksPath=/dev/null \
    archive --format=tar --output="${archive}" "${authority}^{commit}"
) 2>/dev/null \
  || ! "${env_executable}" -i "${tar_executable}" -x -f "${archive}" -C "${tree}"; then
  echo "ERROR: the authority commit could not be extracted" >&2
  exit 2
fi

# The authority's checker, under isolated Python, judging by the authority's
# declaration for the checkout it runs in, both appended after the caller's arguments
# so neither can be pointed elsewhere (gitar on #364).
status=0
(
  cd "${tree}"
  KNOWLEDGE_KIT_ROOT="${tree}" "${python_executable}" -I -c '
import sys

sys.path.insert(0, sys.argv[1])
from tools.credential_check import main

raise SystemExit(main(sys.argv[2:]))
' "${tree}" "$@" --worktree "${worktree}" --policy policy/agent-credentials.yaml
) || status=$?
exit "$status"
