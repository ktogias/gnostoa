#!/bin/sh
set -eu

mode="${1:-}"

enter_repository_root() {
  repository_root="$(pwd -P)"
  while [ ! -e "${repository_root}/.git" ]; do
    if [ "${repository_root}" = "/" ]; then
      echo "ERROR: ./ci/style must run inside a Git worktree" >&2
      return 1
    fi
    repository_root="$(dirname "${repository_root}")"
  done
  cd "${repository_root}"
}

check_candidate_scope() {
  ignored_tracked="$(
    git -c "safe.directory=${repository_root}" \
      ls-files --cached --ignored --exclude-standard -- \
      ':(glob)**/*.py' \
      ':(glob)**/*.pyi' \
      ':(glob)**/*.pyw' \
      ':(glob)**/*.ipynb' \
      ':(glob)**/*.md' \
      ':(glob)**/pyproject.toml' \
      ':(glob)**/ruff.toml' \
      ':(glob)**/.ruff.toml'
  )"
  if [ -n "${ignored_tracked}" ]; then
    echo "ERROR: tracked Ruff input is ignored by Git:" >&2
    printf '%s\n' "${ignored_tracked}" >&2
    return 1
  fi
}

check_ruff_ignore_scope() {
  python - "${repository_root}" <<'PY'
import os
from pathlib import Path
import subprocess
import sys

repository_root = Path(sys.argv[1])
tracked_result = subprocess.run(
    [
        "git",
        "-c",
        f"safe.directory={repository_root}",
        "ls-files",
        "-z",
        "--cached",
    ],
    cwd=repository_root,
    check=True,
    stdout=subprocess.PIPE,
)
tracked = {
    str(repository_root / os.fsdecode(path))
    for path in tracked_result.stdout.split(b"\0")
    if path
}


def discovered(*options: str) -> set[str]:
    completed = subprocess.run(
        [
            sys.executable,
            "-m",
            "ruff",
            "check",
            "--no-cache",
            "--show-files",
            *options,
            ".",
        ],
        cwd=repository_root,
        check=True,
        capture_output=True,
        text=True,
    )
    return set(completed.stdout.splitlines())


without_ignore_files = discovered("--no-respect-gitignore")
with_ignore_files = discovered()
hidden_tracked = sorted(tracked & (without_ignore_files - with_ignore_files))
if hidden_tracked:
    print(
        "ERROR: tracked Ruff input is hidden by Ruff ignore rules:",
        file=sys.stderr,
    )
    for path in hidden_tracked:
        print(Path(path).relative_to(repository_root), file=sys.stderr)
    raise SystemExit(1)
PY
}

case "${mode}" in
  --check)
    enter_repository_root
    check_candidate_scope
    check_ruff_ignore_scope
    python -m ruff format --check --no-cache .
    python -m ruff check --no-cache .
    ;;
  --fix)
    enter_repository_root
    check_candidate_scope
    check_ruff_ignore_scope
    # Remaining unfixable diagnostics must not prevent deterministic formatting;
    # execution/configuration failures must not be converted into a clean result.
    fix_status=0
    python -m ruff check --fix --no-cache . || fix_status=$?
    if [ "${fix_status}" -gt 1 ]; then
      exit "${fix_status}"
    fi
    python -m ruff format --no-cache .
    format_status=0
    python -m ruff format --check --no-cache . || format_status=$?
    lint_status=0
    python -m ruff check --no-cache . || lint_status=$?
    if [ "${format_status}" -gt 1 ]; then
      exit "${format_status}"
    fi
    if [ "${lint_status}" -gt 1 ]; then
      exit "${lint_status}"
    fi
    if [ "${format_status}" -ne 0 ]; then
      exit "${format_status}"
    fi
    exit "${lint_status}"
    ;;
  *)
    echo "usage: ./ci/style {--check|--fix}" >&2
    exit 2
    ;;
esac
