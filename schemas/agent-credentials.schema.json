{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ktogias.github.io/gnostoa/schemas/v1/agent-credentials.schema.json",
  "title": "Agent provider-credential least-privilege declaration",
  "description": "What `knowledge credential-check` verifies an agent's provider token against (Decision 0101). Capability names are the provider adapter's; `min` cannot exceed `max`, which the checker enforces beyond this schema.",
  "type": "object",
  "required": [
    "id",
    "version",
    "credential_kind",
    "max_lifetime_days",
    "resource_owner",
    "repositories",
    "capabilities"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "description": {
      "type": "string"
    },
    "credential_kind": {
      "description": "The adapter's name for the kind of credential, read from the token's prefix.",
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "max_lifetime_days": {
      "description": "The longest remaining lifetime the token may have; a token without an expiry fails.",
      "type": "integer",
      "minimum": 1
    },
    "resource_owner": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "repositories": {
      "description": "The only repositories the token may write.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "min",
          "max"
        ],
        "additionalProperties": false,
        "properties": {
          "min": {
            "$ref": "#/$defs/level"
          },
          "max": {
            "$ref": "#/$defs/level"
          }
        }
      }
    },
    "accepted_unmeasurable": {
      "description": "Levels no non-effecting probe can reach, accepted by name with the owner's reason; each is listed in every verdict.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z_]*:(read|write)$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "\\S"
      }
    }
  },
  "$defs": {
    "level": {
      "enum": [
        "none",
        "read",
        "write"
      ]
    }
  }
}
