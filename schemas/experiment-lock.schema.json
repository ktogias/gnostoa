{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ktogias.github.io/gnostoa/schemas/v1/experiment-lock.schema.json",
  "title": "Gnostoa immutable experiment lock",
  "description": "Written once at EXECUTION_FROZEN. Binds every identity a later execute needs, so execution requires no rediscovery, acquisition or reinterpretation.",
  "type": "object",
  "required": ["schema", "producer", "experiment", "authority", "launch", "tasks", "stage_receipts", "lock_sha256"],
  "properties": {
    "schema": {"const": "gnostoa-experiment-lock/v1"},
    "producer": {"type": "string"},
    "lock_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "experiment": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string"},
        "question": {"type": "string"},
        "claim_boundary": {"type": "string"}
      }
    },
    "authority": {
      "type": "object",
      "required": ["id", "experiment_id", "scope"],
      "properties": {
        "id": {"type": "string"},
        "experiment_id": {"type": "string"},
        "scope": {"type": "array", "items": {"type": "string"}}
      }
    },
    "launch": {
      "type": "object",
      "required": ["executor", "resources"],
      "properties": {
        "executor": {"type": "object"},
        "reviewer": {"type": ["object", "null"]},
        "arms": {"type": "object"},
        "assignment": {"type": "object"},
        "resources": {"type": "object"}
      }
    },
    "capabilities": {"type": "array", "items": {"type": "object"}},
    "stage_receipts": {
      "type": "object",
      "description": "Content-addressed receipt per completed stage; readiness is impossible without all required stages present.",
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "base_tree", "reference_tree", "runtime_image", "oracle_sha256", "capsule_identity", "runner_profile", "qualification"],
        "properties": {
          "id": {"type": "string"},
          "base_tree": {"type": "string"},
          "reference_tree": {"type": "string"},
          "runtime_image": {"type": "string"},
          "prepared_runtime_identity": {"type": ["string", "null"]},
          "oracle_sha256": {"type": "string"},
          "identification_key_sha256": {"type": ["string", "null"]},
          "preparation_receipt": {"type": ["object", "null"]},
          "runner_profile": {"type": "object"},
          "qualification": {"type": "object"},
          "capsule_identity": {"type": "string"}
        }
      }
    }
  }
}
