{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ktogias.github.io/gnostoa/schemas/v1/experiment-spec.schema.json",
  "title": "Gnostoa experiment specification",
  "type": "object",
  "required": [
    "schema",
    "experiment",
    "tasks"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "gnostoa-experiment-spec/v1"
    },
    "experiment": {
      "type": "object",
      "required": [
        "id",
        "executor",
        "resources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string"
        },
        "claim_boundary": {
          "type": "string"
        },
        "executor": {
          "$ref": "#/$defs/agent"
        },
        "reviewer": {
          "$ref": "#/$defs/agent"
        },
        "arms": {
          "type": "object",
          "description": "Arm-visible packets. A run entry attaches only its own arm.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "inputs": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/execution_input"
                }
              }
            }
          }
        },
        "assignment": {
          "type": "object",
          "description": "Assignment order is preregistered experiment material. When arms are declared an explicit ordered schedule is required; the compiler never derives one.",
          "properties": {
            "repetitions": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "arms": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "schedule": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "task",
                  "arm"
                ],
                "properties": {
                  "task": {
                    "type": "string"
                  },
                  "repetition": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  "arm": {
                    "type": "string"
                  }
                }
              }
            },
            "schedule_artifact": {
              "type": "object",
              "required": [
                "path"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "sha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            }
          }
        },
        "resources": {
          "type": "object",
          "required": [
            "timeout_seconds",
            "archive_limit_bytes"
          ],
          "properties": {
            "timeout_seconds": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "archive_limit_bytes": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "network": {
              "type": "object",
              "properties": {
                "mode": {
                  "enum": [
                    "none",
                    "restricted"
                  ]
                },
                "allow": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "capability",
          "certificate",
          "certificate_sha256",
          "required_implementation_sha256",
          "required_runtime_identity",
          "required_configuration_sha256"
        ],
        "properties": {
          "capability": {
            "type": "string"
          },
          "certificate": {
            "type": "string"
          },
          "certificate_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "required_implementation_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "required_runtime_identity": {
            "type": "string"
          },
          "required_configuration_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "requested_bounds": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "agent": {
      "type": "object",
      "required": [
        "id",
        "version",
        "config_sha256"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "config_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "model": {
          "type": "string"
        },
        "small_model": {
          "type": "string"
        }
      }
    },
    "task": {
      "type": "object",
      "required": [
        "id",
        "adapter",
        "source",
        "reference",
        "runtime",
        "oracle",
        "semantics",
        "expectations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "adapter": {
          "enum": [
            "python-pytest",
            "node-vitest",
            "generic-command"
          ]
        },
        "source": {
          "type": "object",
          "required": [
            "repository",
            "base_commit",
            "base_tree"
          ],
          "properties": {
            "repository": {
              "type": "string"
            },
            "base_commit": {
              "type": "string"
            },
            "base_tree": {
              "type": "string"
            }
          }
        },
        "reference": {
          "type": "object",
          "required": [
            "kind",
            "tree"
          ],
          "properties": {
            "kind": {
              "enum": [
                "accepted-merge-commit",
                "accepted-squash-merge-commit",
                "accepted-pr-head",
                "rederived-reference-tree"
              ]
            },
            "commit": {
              "type": "string"
            },
            "tree": {
              "type": "string"
            },
            "repository": {
              "type": "string"
            }
          }
        },
        "runtime": {
          "type": "object",
          "required": [
            "image"
          ],
          "properties": {
            "image": {
              "type": "string"
            },
            "available_plugins": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "preparation_tools": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "artifact"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "artifact": {
                    "type": "string"
                  }
                }
              }
            },
            "relay_image": {
              "type": "string",
              "description": "Immutable relay image digest, required when experimental execution network mode is restricted. Declared, never discovered: no tag is resolved and no image is fetched.",
              "pattern": "^(?:sha256:[a-f0-9]{64}|.+@sha256:[a-f0-9]{64})$"
            }
          }
        },
        "preparation": {
          "type": "object",
          "properties": {
            "scheme": {
              "type": "string",
              "enum": [
                "gnostoa-setuptools-scm-compatible/v1"
              ]
            }
          }
        },
        "oracle": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "identification_key": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "prior_qualification": {
          "type": "object",
          "properties": {
            "evidence_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "receipt": {
              "type": "string",
              "description": "Path to a typed, identity-bound qualification receipt reused instead of rerunning."
            }
          }
        },
        "semantics": {
          "type": "object",
          "required": [
            "requirement",
            "discriminator"
          ],
          "properties": {
            "requirement": {
              "type": "string",
              "minLength": 1
            },
            "discriminator": {
              "type": "object",
              "required": [
                "cases"
              ],
              "properties": {
                "cases": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "behavior_paths": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "controls": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "case"
                ],
                "properties": {
                  "case": {
                    "type": "string"
                  },
                  "corroboration": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string"
                      },
                      "symbol": {
                        "type": "string"
                      },
                      "value_substitutions": {
                        "type": "object"
                      },
                      "prior_qualification_sha256": {
                        "$ref": "#/$defs/sha256"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "harness": {
          "type": "object",
          "properties": {
            "preload_modules": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "isolate_test_config": {
              "type": "boolean"
            },
            "extra_argv": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "expectations": {
          "type": "object",
          "required": [
            "base",
            "reference"
          ],
          "properties": {
            "base": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            },
            "reference": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            }
          }
        },
        "execution": {
          "type": "object",
          "description": "Executor mechanics. Never inferred from the oracle harness, whose invocation belongs to the qualification trust domain only.",
          "properties": {
            "command": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "environment_allowlist": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "credential_environment": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Names only. A secret value never enters a spec, profile or lock."
            },
            "read_only_inputs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/execution_input"
              }
            }
          }
        }
      }
    },
    "execution_input": {
      "type": "object",
      "required": [
        "id",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
