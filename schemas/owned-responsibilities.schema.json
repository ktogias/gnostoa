{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ktogias.github.io/gnostoa/schemas/v1/owned-responsibilities.schema.json",
  "title": "Owned responsibilities",
  "description": "Each responsibility the toolkit owns once, where it is owned, how to extend it, and the source signatures that mark a re-implementation elsewhere (Decision 0102).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "responsibilities"],
  "properties": {
    "id": {"type": "string", "pattern": "\\S"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "responsibilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "responsibility", "owner", "interface", "extend", "decision", "signatures", "allowed", "debt"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "responsibility": {"type": "string", "pattern": "\\S"},
          "owner": {"type": "string", "pattern": "^[A-Za-z0-9_./-]+$"},
          "interface": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}},
          "extend": {"type": "string", "pattern": "\\S"},
          "decision": {"type": "string", "pattern": "\\S"},
          "signatures": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "means"],
              "oneOf": [
                {"required": ["pattern"], "not": {"required": ["structure"]}},
                {"required": ["structure"], "not": {"required": ["pattern"]}}
              ],
              "properties": {
                "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
                "pattern": {"type": "string", "minLength": 1},
                "structure": {"enum": ["relative-to-under-value-error", "shell-command-indirect", "path-prefix-comparison", "yaml-load-indirect", "jsonschema-validator-indirect", "executable-lookup-indirect", "git-argv", "http-request-indirect"]},
                "means": {"type": "string", "pattern": "\\S"}
              }
            }
          },
          "allowed": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "reason"],
              "properties": {
                "path": {"type": "string", "pattern": "^[A-Za-z0-9_./-]+$"},
                "signatures": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                "reason": {"type": "string", "pattern": "\\S"}
              }
            }
          },
          "debt": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "signatures", "lines", "until"],
              "properties": {
                "path": {"type": "string", "pattern": "^[A-Za-z0-9_./-]+$"},
                "signatures": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                "lines": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                "until": {"type": "string", "pattern": "^https://"}
              }
            }
          }
        }
      }
    }
  }
}
