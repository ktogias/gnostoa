{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ktogias.github.io/gnostoa/schemas/v1/review-protected-authority-bundle.schema.json",
  "title": "Gnostoa protected review-authority bundle v1",
  "type": "object",
  "required": [
    "schema_version",
    "authority",
    "policy",
    "qualification_snapshot",
    "acquired_judge"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "authority": {"$ref": "#/$defs/authority"},
    "policy": {"$ref": "#/$defs/effectivePolicy"},
    "qualification_snapshot": {"$ref": "#/$defs/qualificationSnapshot"},
    "acquired_judge": {"$ref": "#/$defs/judge"}
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "gitCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "recommendation": {
      "enum": ["APPROVE", "REQUEST_CHANGES", "COMMENT_ONLY", "ABSTAIN", "UNKNOWN"]
    },
    "ageRule": {
      "oneOf": [
        {
          "type": "object",
          "required": ["mode", "seconds"],
          "properties": {
            "mode": {"const": "max_age"},
            "seconds": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["mode"],
          "properties": {
            "mode": {"const": "not_age_sensitive"}
          },
          "additionalProperties": false
        }
      ]
    },
    "judge": {
      "type": "object",
      "required": [
        "acquisition",
        "source_revision",
        "public_surface_digest",
        "runtime_image",
        "runtime_revision",
        "supported_input_schema_versions",
        "status"
      ],
      "properties": {
        "acquisition": {"enum": ["oci", "native", "unavailable", "partial"]},
        "source_revision": {"$ref": "#/$defs/gitCommit"},
        "public_surface_digest": {"$ref": "#/$defs/sha256"},
        "runtime_image": {"$ref": "#/$defs/nonEmptyString"},
        "runtime_revision": {"$ref": "#/$defs/gitCommit"},
        "supported_input_schema_versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "status": {"enum": ["accepted", "revoked", "deprecated", "unknown"]}
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": [
        "subject",
        "policy_digest",
        "qualification_snapshot_digest",
        "expected_judge"
      ],
      "properties": {
        "subject": {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": {"$ref": "#/$defs/nonEmptyString"},
            "value": {"$ref": "#/$defs/nonEmptyString"}
          },
          "additionalProperties": false
        },
        "policy_digest": {"$ref": "#/$defs/sha256"},
        "qualification_snapshot_digest": {"$ref": "#/$defs/sha256"},
        "expected_judge": {"$ref": "#/$defs/judge"}
      },
      "additionalProperties": false
    },
    "qualificationEntry": {
      "type": "object",
      "required": [
        "reviewer_id",
        "source_id",
        "independence_domain_id",
        "capability_ids",
        "status",
        "observed_at",
        "owner_relation",
        "scope",
        "provenance"
      ],
      "properties": {
        "reviewer_id": {"$ref": "#/$defs/nonEmptyString"},
        "source_id": {"$ref": "#/$defs/nonEmptyString"},
        "independence_domain_id": {"$ref": "#/$defs/nonEmptyString"},
        "capability_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "status": {"enum": ["established", "unestablished", "revoked"]},
        "observed_at": {"$ref": "#/$defs/timestamp"},
        "owner_relation": {"enum": ["owner", "non_owner", "unknown"]},
        "scope": {"type": "object"},
        "provenance": {"type": "object"}
      },
      "additionalProperties": false
    },
    "qualificationSnapshot": {
      "type": "object",
      "required": [
        "snapshot_id",
        "revision",
        "qualifying_authority",
        "observed_at",
        "entries"
      ],
      "properties": {
        "snapshot_id": {"$ref": "#/$defs/nonEmptyString"},
        "revision": {"$ref": "#/$defs/nonEmptyString"},
        "qualifying_authority": {"$ref": "#/$defs/nonEmptyString"},
        "observed_at": {"$ref": "#/$defs/timestamp"},
        "entries": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/qualificationEntry"}
        }
      },
      "additionalProperties": false
    },
    "effectivePolicy": {
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "version",
        "abstract",
        "change_class",
        "review_requirement",
        "subject",
        "collection",
        "qualification",
        "quorum",
        "blockers",
        "conflicts"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "version": {"$ref": "#/$defs/nonEmptyString"},
        "abstract": {"type": "boolean"},
        "change_class": {
          "enum": ["mechanical", "normal", "normative", "critical", "emergency"]
        },
        "review_requirement": {"enum": ["none", "required"]},
        "subject": {
          "type": "object",
          "required": ["comparison_kind", "freshness", "observation_freshness"],
          "properties": {
            "comparison_kind": {"const": "merge_base"},
            "freshness": {"$ref": "#/$defs/ageRule"},
            "observation_freshness": {"$ref": "#/$defs/ageRule"}
          },
          "additionalProperties": false
        },
        "collection": {
          "type": "object",
          "required": ["recognized_sources", "required_sources", "freshness"],
          "properties": {
            "recognized_sources": {"$ref": "#/$defs/stringSet"},
            "required_sources": {"$ref": "#/$defs/stringSet"},
            "freshness": {"$ref": "#/$defs/ageRule"}
          },
          "additionalProperties": false
        },
        "qualification": {
          "type": "object",
          "required": [
            "required_capabilities",
            "owner_reviews_count",
            "snapshot_freshness"
          ],
          "properties": {
            "required_capabilities": {"$ref": "#/$defs/stringSet"},
            "owner_reviews_count": {"type": "boolean"},
            "snapshot_freshness": {"$ref": "#/$defs/ageRule"}
          },
          "additionalProperties": false
        },
        "quorum": {
          "type": "object",
          "required": ["minimum_distinct_domains", "acceptable_recommendations"],
          "properties": {
            "minimum_distinct_domains": {"type": "integer", "minimum": 0},
            "acceptable_recommendations": {
              "type": "array",
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/recommendation"}
            }
          },
          "additionalProperties": false
        },
        "blockers": {
          "type": "object",
          "required": ["recommendations", "unresolved_threads"],
          "properties": {
            "recommendations": {
              "type": "array",
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/recommendation"}
            },
            "unresolved_threads": {"enum": ["ignore", "block", "incomplete"]}
          },
          "additionalProperties": false
        },
        "conflicts": {
          "type": "object",
          "required": ["pairs"],
          "properties": {
            "pairs": {
              "type": "array",
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "uniqueItems": true,
                "items": {"$ref": "#/$defs/recommendation"}
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
