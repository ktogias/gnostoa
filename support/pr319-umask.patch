+def _ensure_subject_directory(path: Path, *, exist_ok: bool) -> None:
+    """Create or normalize one controller-owned materialization directory."""
+
+    try:
+        path.mkdir(mode=_SUBJECT_DIRECTORY_MODE, parents=False, exist_ok=exist_ok)
+        mode = path.lstat().st_mode
+        _need(stat.S_ISDIR(mode) and not stat.S_ISLNK(mode), "SUBJECT_DIRECTORY")
