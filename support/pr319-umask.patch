+    def test_materialization_directories_ignore_restrictive_caller_umask(self) -> None:
+        class InspectingBackend:
+            modes: dict[str, int] | None = None
+
+            def run(
+                self,
+                root: Path,
+                command: Sequence[str],
+                limits: ExecutionLimits,
+            ) -> UntrustedCapture:
+                del command, limits
+                self.modes = {
+                    "root": root.stat().st_mode & 0o777,
+                    "tests": (root / "tests").stat().st_mode & 0o777,
+                    "bin": (root / "bin").stat().st_mode & 0o777,
+                    "deep": (root / "tests" / "deep").stat().st_mode & 0o777,
+                }
+                return UntrustedCapture("completed", 0, b"", b"", 0)
+
+        with tempfile.TemporaryDirectory() as td:
+            repo, subject = _repo(Path(td))
+            backend = InspectingBackend()
+            previous = os.umask(0o077)
+            try:
+                execute(
+                    repo,
+                    subject,
+                    [_evidence("pass", path="tests/deep/e.py")],
+                    [sys.executable, "-c", "pass"],
+                    backend,
+                )
+            finally:
+                os.umask(previous)
+            self.assertEqual(
+                {"root": 0o755, "tests": 0o755, "bin": 0o755, "deep": 0o755},
+                backend.modes,
+            )
+
